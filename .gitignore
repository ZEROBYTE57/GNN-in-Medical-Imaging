# Virtual environments
.venv/
.venv*/
venv/
venv*/
env/
py_venv/
.py_venv/
**/Lib/site-packages/
pyvenv.cfg

MLFGNN/.gitignore_backup

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Working material kept private (on disk and in the OneDrive backup); the public repo is a demonstration
Literature/
CXB/docs/decisions.md
CXB/docs/paper-outline.md
CXB/docs/stats.md
presentations/
paper/

# Data (large or licence-bound): never commit
CXB/data/raw/
CXB/data/processed/*.npz
CXB/results/

# Third-party baseline repositories (cloned, not ours)
CXB/external/

# Third-party data files (e.g. BrainIB's md_AAL_0.4.mat): no stated redistribution terms
*.mat

# Private baseline work (third-party code without a licence, and internal notes)
CXB/scripts/baselines/brainib_v1.py
CXB/scripts/baselines/brainib_smoke.py
CXB/docs/baseline-notes.md
# Word documents for the guide (name the guide, contain unpublished findings)
*.docx

# Early exploration notes (saved AI-chat answers); kept locally, not part of the demonstration
GNN/*.pdf

# Archives (e.g. the paper zip made for Overleaf): never committed
*.zip
